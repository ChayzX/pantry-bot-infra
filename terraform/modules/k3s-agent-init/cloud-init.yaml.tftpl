#cloud-config
# Bootstraps this VM as a k3s AGENT node joining the existing home k3s
# cluster over Tailscale — NOT a standalone Docker host. Pantry Bot itself,
# its cloudflared connector, and Litestream all run as pods scheduled onto
# whichever node k8s picks (see k8s-homelab's pantry-bot/ manifests); this
# cloud-init's only job is making that scheduling possible.
#
# See docs/ORACLE-K3S-JOIN.md for the home-side prerequisites this depends
# on (home must already be running Tailscale and have
# --flannel-backend=wireguard-native enabled) — none of that can be done
# from here, since home isn't managed by this repo.

package_update: true
package_upgrade: false

packages:
  - curl

runcmd:
  # --- Tailscale: the private network k3s's pod overlay will ride on ---
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --authkey=${tailscale_auth_key} --hostname=${node_name} --accept-routes

  # k3s needs this node's OWN tailscale IP (assigned above, not knowable
  # before `tailscale up` runs) to bind the agent's node-ip and to confine
  # pod-network traffic to the tailscale0 interface rather than the public
  # NIC.
  - export TS_IP=$(tailscale ip -4)

  # --- k3s agent join ---
  # K3S_URL/K3S_TOKEN come from the home server (docs/ORACLE-K3S-JOIN.md).
  # --flannel-iface=tailscale0 is what makes the pod network span the WAN
  # link safely — without it k3s tries to route pod traffic over the
  # public interface, which doesn't reach the home server at all.
  - >
    curl -sfL https://get.k3s.io | K3S_URL=${k3s_url} K3S_TOKEN=${k3s_token}
    INSTALL_K3S_EXEC="agent --node-ip=$TS_IP --node-name=${node_name}
    --flannel-iface=tailscale0" sh -

  # Nothing else starts here. The bot, its cloudflared replica, and
  # Litestream are all pods — they get scheduled onto this node by k8s
  # itself once it's Ready, per the Deployment/affinity rules in
  # k8s-homelab, not by anything in this cloud-init.
